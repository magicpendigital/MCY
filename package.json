    "test:dependency-security": "node --test tests/dependency-security.test.mjs",
    "test:owner-control-plane": "node --test tests/owner-control-plane.test.mjs",
    "test:practice-assistant": "node --test tests/practice-assistant.test.mjs tests/practice-safety-suite.test.mjs tests/ai-current-turn-contract.test.mjs",
    "check:practice-catalog": "node scripts/check-reviewed-practice-catalog.mjs",
    "test:practice-catalog": "node --test tests/reviewed-practice-catalog.test.mjs",
    "test:practice-admission-rehearsal": "node --test tests/practice-admission-rehearsal.cjs",
    "test:content-review": "node --test tests/content-review-handler.test.mjs",
    "test:content-workspace": "node --test tests/content-workspace-handler.test.mjs",
    "test:content-foundation-rehearsal": "node --test tests/content-foundation-rehearsal.cjs",
    "test:content-display-rehearsal": "node --test tests/content-display-rehearsal.cjs",
    "test:content-publication-rehearsal": "node --test tests/content-publication-rehearsal.cjs",
    "test:content-publication": "node --test tests/content-publication.test.mjs",
