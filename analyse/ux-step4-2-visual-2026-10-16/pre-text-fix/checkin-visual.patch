+for(const english of [false,true])test('Large text and keyboard body choices '+english,async({page})=>{await page.setViewportSize({width:320,height:568});await enter(page,'?mode=web',english);await page.addStyleTag({content:'.mcy-checkin-page { font-size:20px; } .mcy-checkin-page h1 { font-size:42px!important; } .mcy-body-entry-copy strong { font-size:32px!important; } .mcy-body-entry-copy > span,.mcy-checkin-other-choices > button { font-size:20px!important; }'});const opener=active(page).locator('.mcy-body-disclosure');await opener.focus();await expect(opener).toBeFocused();await page.keyboard.press('Tab');const none=active(page).getByRole('button',{name:english?'No discomfort now':'Không thấy khó chịu',exact:true});await expect(none).toBeFocused();await page.keyboard.press('Enter');await expect(none).toHaveAttribute('aria-pressed','true');await page.keyboard.press('Tab');const uncertain=active(page).getByRole('button',{name:english?'Not sure':'Chưa xác định',exact:true});await expect(uncertain).toBeFocused();await page.keyboard.press('Enter');await expect(uncertain).toHaveAttribute('aria-pressed','true');await expect(none).toHaveAttribute('aria-pressed','false');for(const b of [none,uncertain]){const bounds=await b.boundingBox();expect(bounds!.height).toBeGreaterThanOrEqual(44);expect(await b.evaluate(el=>el.scrollWidth<=el.clientWidth)).toBe(true);}expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth)).toBe(true);await page.screenshot({path:'analyse/ux-step4-2-visual-2026-10-16/checkin-large-'+english+'.png',animations:'disabled'});await opener.focus();await page.keyboard.press('Enter');await expect(opener).toHaveAttribute('aria-expanded','true');await expect(active(page).locator('.mcy-region-list')).toBeVisible();});
